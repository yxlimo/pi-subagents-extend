{
  "name": "pi-subagents-extend",
  "version": "0.1.3",
  "description": "Everything a pi session needs around subagents: scope what a delegated subagent may touch, and keep main-agent-only context out of child prompts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxlimo/pi-subagents-extend.git",
    "directory": "packages/pi-plugin"
  },
  "homepage": "https://github.com/yxlimo/pi-subagents-extend#readme",
  "bugs": "https://github.com/yxlimo/pi-subagents-extend/issues",
  "keywords": [
    "pi",
    "pi-extension",
    "subagents",
    "sandbox",
    "allowlist",
    "agents-md"
  ],
  "pi": {
    "extensions": [
      "src/index.ts",
      "src/main-context.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:helper": "cargo build --release --manifest-path ../helper/Cargo.toml --locked && mkdir -p bin && cp ../helper/target/release/pi-subagents-extend-helper bin/.helper.new && mv -f bin/.helper.new \"bin/pi-subagents-extend-helper-$(node -p 'process.platform + \"-\" + process.arch')\"",
    "pretest": "pnpm run build:helper",
    "test": "pnpm run lint && node ../../scripts/run-tests.mjs",
    "test:mock": "node test/mock-session.test.ts",
    "test:llm": "node test/e2e.test.ts",
    "prepublishOnly": "pnpm run build",
    "prepack": "cp -f ../../README.md ../../LICENSE . && mkdir -p scripts && cp -f ../../scripts/check-role-grants.mjs scripts/",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unicorn": "^79.0.0",
    "pi-hashline-edit-pro": "7.2.0",
    "pi-subagents": "0.89.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  },
  "files": [
    "src",
    "skills",
    "bin",
    "scripts"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "bin": {
    "pi-subagents-extend-check": "./scripts/check-role-grants.mjs"
  }
}
